{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2022"],
    "sourceMap": true
  },
  "include": ["./**/*.ts", "./types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "jobs/scheduler.ts",
    "media/**",
    "forum/**",
    "weather/**",
    "repeaters/**",
    "notifications/notification-dispatcher.ts"
  ]
}
