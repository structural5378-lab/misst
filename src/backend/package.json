{
  "name": "mist-core-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MISST Core — self-hosted backend (auth/users foundation).",
  "scripts": {
    "start": "tsx src/backend/main.ts",
    "dev": "tsx watch src/backend/main.ts",
    "build": "tsc -p src/backend/tsconfig.json",
    "serve": "node dist/backend/main.js",
    "db:migrate": "psql \"$DATABASE_URL\" -f src/backend/db/schema.sql"
  },
  "dependencies": {
    "argon2": "^0.40.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}