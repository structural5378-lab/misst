{
  "name": "LightningAlertSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID (Base44 user.id)"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for lightning alerts"
    },
    "radius_miles": {
      "type": "number",
      "default": 10,
      "description": "Alert radius in miles (5/10/15/25/50)"
    },
    "push_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Send a push notification when a strike is within radius"
    },
    "sound_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Play an alert sound on push"
    },
    "vibration_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Vibrate on push"
    },
    "auto_open_map": {
      "type": "boolean",
      "default": false,
      "description": "Automatically open RadioScope centered on the strike"
    },
    "last_alert_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent lightning notification delivered to this user. Drives the 60s grouping/throttle window (server-managed)."
    },
    "recent_count": {
      "type": "number",
      "default": 0,
      "description": "Number of in-radius strikes seen during the current grouping window (server-managed)."
    },
    "recent_window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of the current grouping window (server-managed)."
    },
    "recent_escalated": {
      "type": "number",
      "default": 0,
      "description": "Escalation tier reached in the current window (0=none, 1=frequent, 2=storm). Prevents repeated escalation notifications (server-managed)."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}