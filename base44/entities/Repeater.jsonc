{
  "name": "Repeater",
  "type": "object",
  "properties": {
    "callsign": {
      "type": "string",
      "description": "Repeater callsign (e.g. K4MIA)"
    },
    "frequency": {
      "type": "number",
      "description": "Frequency in MHz"
    },
    "offset": {
      "type": "string",
      "description": "Offset (e.g. +5.0 MHz)"
    },
    "tone": {
      "type": "string",
      "description": "PL tone or DCS code"
    },
    "band": {
      "type": "string",
      "enum": [
        "GMRS",
        "Ham",
        "Business",
        "Public Safety",
        "Other"
      ],
      "default": "GMRS",
      "description": "Radio service band"
    },
    "location": {
      "type": "string",
      "description": "City, State"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "busy"
      ],
      "default": "online"
    },
    "owner_callsign": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "community_id": {
      "type": "string",
      "description": "Community this repeater belongs to (data isolation)"
    },
    "community_name": {
      "type": "string",
      "description": "Community name for display"
    },
    "coverage_radius": {
      "type": "number",
      "description": "Coverage radius in miles"
    },
    "coverage_color": {
      "type": "string",
      "default": "#8B5CF6",
      "description": "Hex color for the coverage circle"
    },
    "coverage_opacity": {
      "type": "number",
      "default": 0.18,
      "description": "Coverage circle fill opacity (0-1)"
    },
    "coverage_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether the coverage circle is drawn on the map"
    },
    "height_m": {
      "type": "number",
      "description": "Antenna height in meters"
    },
    "erp_watts": {
      "type": "number",
      "description": "Effective radiated power in watts"
    },
    "antenna_type": {
      "type": "string",
      "description": "Antenna type / model"
    }
  },
  "required": [
    "callsign",
    "frequency"
  ]
}