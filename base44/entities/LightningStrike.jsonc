{
  "name": "LightningStrike",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "description": "Strike latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Strike longitude"
    },
    "strike_time": {
      "type": "string",
      "format": "date-time",
      "description": "When the strike occurred (provider-reported timestamp, UTC)"
    },
    "provider": {
      "type": "string",
      "default": "mock",
      "description": "Source provider slug (mock, live, vaisala, earthnetworks, blitzortung, ...)"
    },
    "provider_strike_id": {
      "type": "string",
      "description": "Provider-native unique strike ID. Used for cross-poll dedupe so the same strike is never persisted twice. Empty for mock/dev strikes."
    },
    "strike_type": {
      "type": "string",
      "description": "Strike type/polarity if reported by the provider (cloud-to-ground, positive, negative, ...)"
    },
    "intensity": {
      "type": "number",
      "description": "Relative intensity 0-100 (provider-specific units)"
    },
    "metadata": {
      "type": "string",
      "description": "JSON of provider-specific extra data (peak current, polarity, raw payload, etc.)"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the notification pipeline has processed this strike (dedupe/fallback flag)"
    }
  },
  "required": [
    "latitude",
    "longitude"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}