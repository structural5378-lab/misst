{
  "name": "PlatformAuditLog",
  "type": "object",
  "properties": {
    "admin_id": {
      "type": "string",
      "description": "MIST user ID of the platform admin who performed the action"
    },
    "admin_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "community_suspend | community_reactivate | community_archive | community_clone | community_delete | community_update | community_backup | ownership_transfer | member_remove | member_ban | member_unban | member_promote | member_demote | announcement_send | content_delete | content_restore | content_pin | content_unpin | content_lock | content_unlock | content_feature | content_unfeature | report_dismiss | report_warn | report_suspend | report_ban"
    },
    "target_type": {
      "type": "string",
      "description": "community | member | content | report"
    },
    "target_id": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "community_name": {
      "type": "string"
    },
    "previous_value": {
      "type": "string",
      "description": "JSON snapshot of the value before the change"
    },
    "new_value": {
      "type": "string",
      "description": "JSON snapshot of the value after the change"
    },
    "ip_address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "admin_id",
    "action"
  ]
}