{
  "name": "CommunityMember",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Global MIST user ID (UUID)"
    },
    "user_email": {
      "type": "string",
      "description": "User email for display"
    },
    "user_name": {
      "type": "string",
      "description": "Denormalized display name"
    },
    "user_avatar": {
      "type": "string",
      "description": "Denormalized avatar URL"
    },
    "user_callsign": {
      "type": "string",
      "description": "Denormalized callsign"
    },
    "community_id": {
      "type": "string",
      "description": "Community ID this membership belongs to"
    },
    "community_name": {
      "type": "string",
      "description": "Community name for display"
    },
    "role": {
      "type": "string",
      "enum": [
        "community_owner",
        "community_admin",
        "net_control",
        "moderator",
        "trusted_member",
        "member",
        "guest"
      ],
      "default": "member",
      "description": "Community-level role (drives community-scoped permissions via resolvePermissions)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended",
        "banned",
        "left"
      ],
      "default": "active"
    },
    "joined_date": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_by": {
      "type": "string",
      "description": "User ID of who assigned the current role"
    },
    "assigned_by_email": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "user_email",
    "community_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}